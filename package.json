{
  "name": "huawei-ce6800-automation",
  "version": "1.0.0",
  "description": "Web app for automating Huawei CE6800 spine-leaf architecture deployment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "socket.io": "^4.7.2",
    "net-snmp": "^3.10.1",
    "ssh2": "^1.14.0",
    "winston": "^3.10.0",
    "joi": "^17.9.2",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": ["huawei", "ce6800", "network-automation", "spine-leaf", "datacenter"],
  "author": "Network Automation Team",
  "license": "MIT"
}
